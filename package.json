{
  "name": "gancio",
  "version": "2.0.0-alpha.2",
  "description": "A shared agenda for local communities",
  "author": "lesion",
  "bugs": {
    "email": "lesion@autistici.org",
    "url": "https://framagit.org/les/gancio/issues"
  },
  "homepage": "https://gancio.org",
  "keywords": [
    "AP",
    "gancio",
    "events",
    "federation",
    "activitypub",
    "event",
    "server",
    "self-host",
    "app"
  ],
  "files": [
    ".output",
    "i18n",
    "server",
    "gancio_plugins"
  ],
  "tsup": {
    "entry": [
      "server/cli/index.ts"
    ],
    "outDir": ".cli",
    "format": "esm",
    "target": "esnext",
    "sourcemap": false,
    "minify": true,
    "bundle": true,
    "clean": true,
    "splitting": false,
    "env": {
      "NODE_ENV": "production"
    },
    "banner": {
      "js": "#!/usr/bin/env node"
    }
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://framagit.org/les/gancio"
  },
  "type": "module",
  "scripts": {
    "build": "nuxi build",
    "build:cli": "tsup",
    "build:doc": "cd docs && bundle exec jekyll b",
    "build:wc": "cd webcomponents; pnpm run build:lib; cp dist/gancio-events.umd.cjs ../wp-plugin/js/gancio-events.es.js; cp dist/gancio-events.umd.cjs ../public/gancio-events.es.js; cp dist/gancio-events.umd.cjs ../docs/assets/js/gancio-events.es.js;",
    "dev": "NODE_OPTIONS='--trace-warnings' nuxi dev",
    "postinstall": "nuxi prepare",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:ui": "TZ=UTC vitest --ui --open",
    "doc:dev": "cd docs && bundle exec jekyll s --drafts",
    "migrate": "NODE_ENV=production sequelize db:migrate",
    "migrate:dev": "sequelize db:migrate",
    "analyze": "nuxt build --analyze",
    "circular": "madge --circular --extensions ts,js,vue --ts-config server/tsconfig.madge.json server"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@nuxt/kit": "^4.2.2",
    "@nuxtjs/sitemap": "7.6.0",
    "@peertube/http-signature": "^1.7.0",
    "@popperjs/core": "^2.11.8",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/postgres": "^7.0.0-alpha.47",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "@types/lodash": "^4.17.24",
    "@types/mime-types": "^3.0.1",
    "@types/yargs": "^17.0.35",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.1.0",
    "ajv": "^8.18.0",
    "dompurify": "^3.4.0",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "ical.js": "^2.2.1",
    "jose": "^6.2.0",
    "jsdoc-api": "^9.3.5",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lodash.intersection": "^4.4.0",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "nuxt": "^4.2.2",
    "nuxt-auth-utils": "0.5.29",
    "pug": "^3.0.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "sqlite3": "^5.1.7",
    "telegraf": "^4.16.3",
    "umzug": "^3.8.2",
    "v-calendar": "^3.1.2",
    "vue": "3.5.32",
    "vue-screen-utils": "^1.0.0-beta.13",
    "vuetify": "^3.12.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@npmcli/arborist": "^9.1.9",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/hints": "1.0.3",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/i18n": "10.2.4",
    "@sequelize/mariadb": "^7.0.0-alpha.47",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/email-templates": "^10.0.4",
    "@types/jsonld": "^1.5.15",
    "@types/luxon": "^3.7.1",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.6.0",
    "@types/pug": "^2.0.10",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "4.1.4",
    "@vue/devtools-core": "^8.0.7",
    "@vue/devtools-kit": "^8.0.7",
    "@vue/test-utils": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "consola": "^3.4.2",
    "email-templates": "^13.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-vuetify": "^2.6.0",
    "h3": "^1.15.4",
    "happy-dom": "^20.9.0",
    "html-to-text": "^9.0.5",
    "ics": "^3.8.1",
    "jsdom": "^29.0.2",
    "jsonld": "^9.0.0",
    "linkify-html": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "madge": "^8.0.0",
    "material-design-icons-iconfont": "^6.7.0",
    "mitt": "^3.0.1",
    "negotiator": "^1.0.0",
    "nitro-test-utils": "^0.11.2",
    "nitropack": "^2.13.0",
    "npm-packlist": "^10.0.3",
    "ofetch": "^1.5.1",
    "playwright-core": "^1.59.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.9",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.4",
    "yargs": "^18.0.0",
    "zod": "^4.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sqlite3",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@vue/server-renderer": "3.5.29",
      "vue": "3.5.29"
    },
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "core-js",
    "esbuild",
    "sharp",
    "sqlite3",
    "unrs-resolver"
  ],
  "packageManager": "pnpm@10.29.3"
}
