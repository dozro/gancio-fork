  "type": "module",
  "scripts": {
    "build": "nuxi build",
    "dev": "NODE_OPTIONS='--trace-warnings' nuxi dev",
    "postinstall": "nuxi prepare",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "lint": "eslint .",
    "test": "cp .env.test .env && cp tests/gancio.test.sqlite gancio.test.sqlite && vitest --run",
    "test:watch": "TZ=UTC vitest",
    "test:ui": "TZ=UTC vitest --ui --open",
    "doc": "cd docs && bundle exec jekyll b",
    "doc:dev": "cd docs && bundle exec jekyll s --drafts",
    "migrate": "NODE_ENV=production sequelize db:migrate",
    "migrate:dev": "sequelize db:migrate",
    "analyze": "nuxt build --analyze",
    "build:wc": "cd webcomponents; yarn build:lib; cp dist/gancio-events.umd.cjs ../wp-plugin/js/gancio-events.es.js; cp dist/gancio-events.umd.cjs ../public/gancio-events.es.js; cp dist/gancio-events.umd.cjs ../docs/assets/js/gancio-events.es.js;"
  },
